{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SwiftAgent Widget",
  "description": "Embed the SwiftAgent AI chat widget on any website with a single script tag.",
  "colors": {
    "primary": "#006BE5",
    "light": "#3D8BFF",
    "dark": "#005FCA"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/attributes",
              "configuration/display-modes",
              "configuration/styling"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/chat",
              "features/file-uploads"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/custom-triggers",
              "guides/spa-integration",
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "JavaScript API",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api/overview",
              "api/mount",
              "api/open-close-toggle"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://swiftagents.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://swiftagents.org"
    }
  },
  "footer": {
    "socials": {
      "website": "https://swiftagents.org"
    }
  }
}
